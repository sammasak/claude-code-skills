#!/usr/bin/env bash
# Repo pre-push gate: the hook suite must be green before hooks ship.
# The nix shell supplies shellcheck/yq so their cases RUN here rather than
# silently skipping (the suite skips tools it cannot find).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
nix shell nixpkgs#shellcheck nixpkgs#yq-go --command bash tests/test-hooks.sh
